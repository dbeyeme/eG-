# Voyageur241 Scanner — environnement
# Copier vers .env / .env.local et adapter.

# Base API (Railway prod ou local)
# Prod: https://scanner-api-production-e278.up.railway.app
# Local: http://127.0.0.1:3001
VITE_API_BASE_URL=https://scanner-api-production-e278.up.railway.app

# Chemin relatif de vérification ticket (POST)
VITE_API_TICKET_VERIFY_PATH=/api/v1/tickets/verify

# Origine autorisée côté CORS API
VITE_CORS_ORIGIN=https://scanner-app-gamma.vercel.app

# Version affichée dans l’app
VITE_APP_VERSION=0.2.0
